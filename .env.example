BB_API_CLIENT=
BB_API_SECRET=
BB_API_KEY=
BB_API_BASE_URL=https://webapp.buchhaltungsbutler.de/api/v1
# Optional: 0 oder false schaltet den Online-Abruf fehlender BMF-Auslandstabellen (Reisekosten) ab.
# BHB_TRAVEL_RATES_ONLINE=0
# Optional: 1 oder true bietet nur lesende Tools an (kein Buchen, Anlegen, Hochladen, Löschen).
# BHB_READ_ONLY=1
# Nur für den HTTP-Betrieb (dist/http-server.js):
# MCP_AUTH_TOKEN=            # Pflicht, mindestens 32 zufällige Zeichen: openssl rand -base64 48
# MCP_ALLOWED_HOSTS=mcp.deine-domain.example
# MCP_TRUST_PROXY=1          # Anzahl der Reverse-Proxys vor dem Server
